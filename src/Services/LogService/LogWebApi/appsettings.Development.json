{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Using": [ "Serilog.Enrichers.CorrelationId", "Serilog.Sinks.Debug", "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "Enrich": [ "WithCorrelationId", "FromLogContext" ], // loglara ıd veriyor , log içinde yapan kişnin bilgilerini alıyor
    "WriteTo": [ //KAYNAKLARI BELİRTİYOR
      
      {
        "Name": "Debug",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3} {Message:lj} {Newline} {Exception}]"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3} {Message:lj} {Newline} {Exception}]"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
     
    ]
  },
  "AllowedHosts": "*"
}
