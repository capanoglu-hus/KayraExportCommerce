{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Using": [ "Serilog.Enrichers.CorrelationId", "Serilog.Sinks.MSSqlServer", "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "Enrich": [ "WithCorrelationId", "FromLogContext" ],
    "WriteTo": [ //KAYNAKLARI BELİRTİYOR
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.json",
          "rollingInterval": "Day", // gün boyunca tek dosya
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server=localhost\\SQLEXPRESS;Database=KayraExport;Trusted_Connection=True;TrustServerCertificate=True;",
          "sinkOptionsSection": {
            "tableName": "Logs", // logs tablosuna
            "autoCreateSqlTable": true // otomatik oluşturacak
          }
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3} {Message:lj} {Newline} {Exception}]"
        }
      },
      {
        "Name": "Seq",
        "Args": { // docker ile 
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },

  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },

  "AllowedHosts": "*"
}
