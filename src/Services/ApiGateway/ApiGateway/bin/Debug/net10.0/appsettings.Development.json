{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Jwt": {
    "Issuer": "AuthApi",
    "Audience": "AuthApiClient",
    "SecurityKey": "1d95192466435a1d771a3c56a4c0770f",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed-policy",
        "Match": {
          "Path": "/auth-service/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth-service" },
          { "PathPrefix": "/api" }
        ]
      },
      "production-route": {
        "ClusterId": "production-cluster",
        "RateLimiterPolicy": "fixed-policy",
        "Match": {
          "Path": "/production-service/{**catch-all}"
        },
        /* kullanıcı bilgilerini gönderme*/
        "Transforms": [
          { "PathRemovePrefix": "/production-service" },
          { "PathPrefix": "/api" },
          {
            "RequestHeader": "X-User-Id",
            "Append": "{Claim.sub}"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "authService": {
            "Address": "http://localhost:5238"
          }
        }
      },
      "production-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "productionService": {
            "Address": "http://localhost:5121"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}